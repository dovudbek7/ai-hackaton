
import os
import re
import logging
from django.core.management.base import BaseCommand
from asgiref.sync import sync_to_async
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup, ReplyKeyboardRemove
from telegram.ext import (
    ApplicationBuilder,
    ContextTypes,
    CommandHandler,
    MessageHandler,
    CallbackQueryHandler,
    ConversationHandler,
    filters,
)
from hackathon.models import Application, BotUser

# Enable logging
logging.basicConfig(
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s", level=logging.INFO
)
logger = logging.getLogger(__name__)

# States from STEP 1 to 7 (Modified)
# STEP 0: Info -> Start Check
# STEP 1: Phone Input (Previously District/School)
# STEP 2: Pre-check & Intrigue
# STEP 3: Channel Follow Gate
# STEP 4: Result Display

(
    PHONE_INPUT,
    INTRIGUE_CHECK,
    CHANNEL_GATE,
    RESULT_DISPLAY
) = range(4)

# Required Channels (Updated based on user edit in Step 218)
REQUIRED_CHANNELS = [
    "@kaizen_md",
    # Add other channels here if needed
]

@sync_to_async
def find_application(phone, user_id=None):
    # Normalize input phone: remove all non-digits
    clean_input = re.sub(r'\D', '', phone)
    if not clean_input:
        return None
        
    target_last_9 = clean_input[-9:]
    
    # NEW logic: Check if this user (Account) is already locked to a number
    bot_user, _ = BotUser.objects.get_or_create(telegram_id=user_id)
    if bot_user.claimed_phone:
        db_phone_clean = re.sub(r'\D', '', bot_user.claimed_phone)
        if db_phone_clean.endswith(target_last_9):
            # Matches their locked number
            app = Application.objects.filter(phone__endswith=target_last_9).first()
            if app:
                return {
                    'id': app.id,
                    'full_name': app.full_name,
                    'status': app.status,
                    'ai_status': app.ai_status,
                    'already_claimed': True
                }
        else:
            # Trying to check a DIFFERENT number
            return {'error': 'limit_reached'}

    # Fetch all applications and check in Python
    candidates = Application.objects.all()
    
    # Robust matching
    for app in candidates:
        if not app.phone:
            continue
        db_phone_clean = re.sub(r'\D', '', app.phone)
        if db_phone_clean.endswith(target_last_9):
            # Found it! Since we removed the check for app.telegram_user_id,
            # multiple accounts can find the same application.
            return {
                'id': app.id,
                'full_name': app.full_name,
                'status': app.status,
                'ai_status': app.ai_status
            }
            
    return None

@sync_to_async
def claim_application(phone, user_id, username=None):
    # Lock this Telegram account to this phone number
    clean_phone = re.sub(r'\D', '', phone)
    bot_user, _ = BotUser.objects.get_or_create(telegram_id=user_id)
    if not bot_user.claimed_phone:
        bot_user.claimed_phone = clean_phone
        if username and not bot_user.username:
            bot_user.username = username
        bot_user.save()


class Command(BaseCommand):
    help = "Runs the Deterministic Telegram bot"

    def handle(self, *args, **options):
        token = os.getenv("TELEGRAM_BOT_TOKEN")
        if not token:
            self.stdout.write(self.style.ERROR("TELEGRAM_BOT_TOKEN not found."))
            return

        application = ApplicationBuilder().token(token).build()

        conv_handler = ConversationHandler(
            entry_points=[CommandHandler("start", self.start)],
            states={
                PHONE_INPUT: [
                    MessageHandler(filters.TEXT & ~filters.COMMAND, self.process_phone)
                ],
                INTRIGUE_CHECK: [
                    CallbackQueryHandler(self.proceed_to_channel_gate, pattern="^see_result$"),
                    CallbackQueryHandler(self.retry_check, pattern="^retry_check$")
                ],
                CHANNEL_GATE: [
                    CallbackQueryHandler(self.verify_channels, pattern="^check_subs$"),
                    CallbackQueryHandler(self.verify_channels_initial, pattern="^start_check$")
                ],
                RESULT_DISPLAY: [
                    CallbackQueryHandler(self.restart_flow, pattern="^restart_flow$")
                ]
            },
            fallbacks=[CommandHandler("start", self.start)],
            per_message=False
        )

        application.add_handler(conv_handler)
        application.add_error_handler(self.handle_error)
        
        self.stdout.write(self.style.SUCCESS("Bot started polling..."))
        application.run_polling()

    # STEP 0: START + INFO POST
    async def start(self, update: Update, context: ContextTypes.DEFAULT_TYPE):
        context.user_data.clear()
        
        info_text = (
            "🤖 **Assalomu alaykum!**\n\n"
            "Ushbu bot orqali siz hakatonda qatnashish uchun topshirgan "
            "arizangiz holatini tekshirishingiz mumkin.\n\n"
            "📋 **Eslatma:**\n"
            "• Natijalar maxfiy va faqat shaxsiy tekshirish uchun.\n"
            "• Bitta qatnashuvchi faqat o'zini natijasini ko'rishi mumkin.\n"
            "• Agar ma'lumot topilmasa, qayta urinib ko'rishingiz mumkin."
        )
        
        keyboard = [[InlineKeyboardButton("Natijani ko‘rish", callback_data="start_check")]]
        reply_markup = InlineKeyboardMarkup(keyboard)
        
        await update.message.reply_text(info_text, parse_mode='Markdown', reply_markup=reply_markup)
        return CHANNEL_GATE

    # STEP 1: CHANNEL VERIFICATION (MOVED TO FIRST)
    async def verify_channels_initial(self, update: Update, context: ContextTypes.DEFAULT_TYPE):
        """Initial channel verification after start button"""
        query = update.callback_query
        await query.answer()
        return await self.verify_channels(update, context)
    
    async def verify_channels(self, update: Update, context: ContextTypes.DEFAULT_TYPE):
        text = update.message.text
        phone = re.sub(r'\D', '', text)
        
        if len(phone) < 9:
            await update.message.reply_text("Telefon raqam noto'g'ri. Qaytadan kiriting (kamida 9 ta raqam):")
            return PHONE_INPUT
        
        context.user_data['phone'] = phone
        
        # Perform Search (No District/School)
        app_data = await find_application(phone, user_id=update.effective_user.id)
        
        if isinstance(app_data, dict) and app_data.get('error') == 'limit_reached':
             await update.message.reply_text(
                "❌ **Siz allaqachon birinchi arizangizni tekshirgansiz.**\n\n"
                "Bitta Telegram akkauntdan faqat bitta arizani ko'rish mumkin.",
                parse_mode='Markdown'
            )
             return PHONE_INPUT

        if isinstance(app_data, dict) and app_data.get('error') == 'already_taken':
             await update.message.reply_text(
                "❌ **Bu ariza allaqachon boshqa foydalanuvchi tomonidan tekshirilgan.**\n\n"
                "Har bir foydalanuvchi faqat o'ziga tegishli raqamni tekshirishi mumkin.",
                parse_mode='Markdown'
            )
             return PHONE_INPUT
             
        if not app_data:
            # NOT FOUND
            keyboard = [[InlineKeyboardButton("Qayta tekshirish", callback_data="retry_check")]]
            reply_markup = InlineKeyboardMarkup(keyboard)
            await update.message.reply_text(
                "Bu ma’lumotlar bo‘yicha ro‘yxatdan o‘tish topilmadi",
                reply_markup=reply_markup
            )
            return INTRIGUE_CHECK # Reuse state to handle retry button
        
        # FOUND
        context.user_data['app_data'] = app_data
        
        full_name = app_data['full_name']
        
        msg = (
            f"Biz **{full_name}** uchun natijani topdik 🎉 \n"
            "👀 Natijani ko‘rishga tayyormisiz? "
        )
        
        keyboard = [[InlineKeyboardButton("Ha, natijani ko‘rish 🎉", callback_data="see_result")]]
        reply_markup = InlineKeyboardMarkup(keyboard)
        
        await update.message.reply_text(msg, parse_mode='Markdown', reply_markup=reply_markup)
        return INTRIGUE_CHECK

    async def retry_check(self, update: Update, context: ContextTypes.DEFAULT_TYPE):
        query = update.callback_query
        await query.answer()
        
        # Return to Phone Input
        await query.edit_message_text(
            "Telefon raqamingizni kiriting:\n"
            "(Masalan: 991234567 yoki +998991234567)"
        )
        return PHONE_INPUT

    # STEP 4: RESULT DISPLAY (After re-verifying channels if needed)
    async def show_result(self, update: Update, context: ContextTypes.DEFAULT_TYPE):
        app_data = context.user_data.get('app_data')
        if not app_data:
            return await self.start(update, context)
            
        # Claim the application for this user (Account -> Phone lock)
        username = update.effective_user.username or update.effective_user.first_name or None
        await claim_application(context.user_data.get('phone'), update.effective_user.id, username)
            
        status = app_data['status']
        
        response = ""
        if status == 'pending':
            response = "⏳ Arizangiz qabul qilingan.\nHozirda ko‘rib chiqilmoqda. Iltimos kuting."
        elif status == 'accepted' or status == 'approved':
            response = "Tabriklaymiz! 🎉\nSiz hakatonni dars bosqichga qabul qilindingiz."
        elif status == 'rejected':
            response = "Afsuski suni'y intelekt sizni dars jarayonlariga qabul qilmadi. Afsusdamiz 😕😞"
        else:
            response = f"Holat: {status}"

        # RESTART BUTTON
        # keyboard = [[InlineKeyboardButton("Yana boshqa odamni tekshirish", callback_data="restart_flow")]]
        # reply_markup = InlineKeyboardMarkup(keyboard)
        
        # Always send new message for result to ensure user sees it
        await context.bot.send_message(
            chat_id=update.effective_chat.id,
            text=response
        )
             
        return RESULT_DISPLAY

    async def restart_flow(self, update: Update, context: ContextTypes.DEFAULT_TYPE):
        query = update.callback_query
        await query.answer()
        
        context.user_data.pop('phone', None)
        context.user_data.pop('app_data', None)
        
        # Go back to phone input directly?
        # "Return to STEP 1" -> Step 1 is Phone Input now.
        
        await query.edit_message_text(
            "Telefon raqamingizni kiriting:\n"
            "(Masalan: 991234567 yoki +998991234567)"
        )
        return PHONE_INPUT
